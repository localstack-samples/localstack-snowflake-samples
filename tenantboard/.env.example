# Every variable Tenantboard reads, with its default. Nothing here is required
# for the emulator path except the LocalStack token. The Makefile does not load
# this file: export what you change (or `set -a; . ./.env; set +a`).

# --- Emulator --------------------------------------------------------------
# LocalStack auth token. The Makefile also reads ~/.localstack/default.env.
# LOCALSTACK_AUTH_TOKEN=
SNOWFLAKE_IMAGE=localstack/snowflake-next:latest
SNOWFLAKE_PORT=4566

# --- Shared ----------------------------------------------------------------
# EMULATOR (default) or SNOWFLAKE_CLOUD: picks the connection used by the API,
# the seed and demo scripts, and the tests.
TEST_TARGET=EMULATOR
# Key pair for SNOWFLAKE_JWT auth, used by both identities. `make up` generates a throwaway one.
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/rsa_key.p8
SNOWFLAKE_WAREHOUSE=TB_WH

# Admin identity: deploys, provisions tenant roles, seeds. Never used by the API.
SNOWFLAKE_USER=SAMPLE_SVC
# Emulator default ACCOUNTADMIN; required on real Snowflake (needs CREATE DATABASE,
# CREATE ROLE and MANAGE GRANTS, e.g. a role holding SYSADMIN and SECURITYADMIN).
SNOWFLAKE_ROLE=

# App identity: the API's service user. Each request runs under a tenant role.
TB_APP_USER=TENANTBOARD_SVC
TB_DATABASE=TENANTBOARD
TB_SCHEMA=APP
# Open per-role Snowflake sessions kept by the API (least recently used are closed).
TB_MAX_ROLE_CONNECTIONS=16
TB_MAX_UPLOAD_BYTES=1000000
TB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# make run
API_PORT=8000
WEB_PORT=5173

# --- Real Snowflake (TEST_TARGET=SNOWFLAKE_CLOUD) ---------------------------
# Read only on the cloud path.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_HOST=
