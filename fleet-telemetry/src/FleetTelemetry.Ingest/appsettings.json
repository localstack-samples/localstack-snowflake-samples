{
  "Snowflake": {
    "Account": "myorg-fleet",
    "Host": "myorg-fleet.snowflakecomputing.com",
    "Port": 443,
    "User": "FLEET_SVC",
    "PrivateKeyPath": "/run/secrets/snowflake_rsa_key.p8",
    "Role": "FLEET_APP",
    "Warehouse": "FLEET_WH",
    "Database": "FLEET",
    "Schema": "TELEMETRY",
    "Application": "fleet-telemetry-ingest"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true
      }
    }
  }
}
