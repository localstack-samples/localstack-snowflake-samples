# Every variable the sample reads. The Makefile reads LOCALSTACK_AUTH_TOKEN from
# ~/.localstack/default.env when it is not exported.

# LocalStack auth token (never commit a real value).
LOCALSTACK_AUTH_TOKEN=

# Emulator image; defaults to the newest build. Pin a tag or digest to freeze it.
SNOWFLAKE_IMAGE=localstack/snowflake-next:latest

# Host port of the compose emulator (make up, seed, run, demo). Testcontainers picks its own.
SNOWFLAKE_PORT=4566

# EMULATOR (default) or SNOWFLAKE_CLOUD (make test-cloud).
TEST_TARGET=EMULATOR

# Key for key-pair (JWT) authentication; make up generates .secrets/rsa_key.p8.
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/rsa_key.p8

# A Snowflake account: the app reads these over appsettings.json (or Snowflake__Account and so on).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_HOST=
SNOWFLAKE_USER=FLEET_SVC
SNOWFLAKE_ROLE=FLEET_APP
SNOWFLAKE_WAREHOUSE=FLEET_WH
SNOWFLAKE_DATABASE=FLEET
SNOWFLAKE_SCHEMA=TELEMETRY

# make demo: port of the API it starts.
DEMO_PORT=5080
