# Every variable the metering API, the seed and the tests read, with its default.
# Nothing here is needed for the local workflow except the LocalStack token.
# The Makefile does not load this file: export what you change (direnv, or
# `set -a; . ./.env; set +a`).

# --- Local Snowflake (make up) ----------------------------------------------
# LocalStack auth token. The Makefile also reads ~/.localstack/default.env.
# LOCALSTACK_AUTH_TOKEN=
SNOWFLAKE_IMAGE=localstack/snowflake-next:latest
# Host port of the local Snowflake. The integration tests pick their own.
SNOWFLAKE_PORT=4566

# --- Connection (the same shape locally and in production) -------------------
# EMULATOR (default) or SNOWFLAKE_CLOUD: picks the defaults below and the target
# of the integration tests.
TEST_TARGET=EMULATOR
# Emulator defaults: account snowflake on snowflake.localhost.localstack.cloud.
# On a real account set SNOWFLAKE_ACCOUNT; SNOWFLAKE_HOST defaults to
# <account>.snowflakecomputing.com and the port to 443.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_HOST=
SNOWFLAKE_USER=METERING_SVC
SNOWFLAKE_ROLE=METERING_APP
SNOWFLAKE_WAREHOUSE=METERING_WH
SNOWFLAKE_DATABASE=METERING
SNOWFLAKE_SCHEMA=BILLING
# Unencrypted PKCS#8 key for SNOWFLAKE_JWT auth. `make up` generates a throwaway one.
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/rsa_key.p8

# --- API ---------------------------------------------------------------------
HTTP_ADDR=127.0.0.1:8080
# DEBUG, INFO, WARN or ERROR
LOG_LEVEL=INFO
