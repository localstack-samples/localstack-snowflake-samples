<?xml version="1.0" encoding="UTF-8"?>
<!-- Quiet test output: warnings and errors, plus container start-up and migrations. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="tc" level="INFO"/>
    <logger name="liquibase.ui" level="INFO"/>
    <logger name="net.snowflake" level="ERROR"/>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
