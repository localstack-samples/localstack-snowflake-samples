# Every variable the sample reads. Nothing here is required for `./mvnw verify`
# except LOCALSTACK_AUTH_TOKEN; the Makefile also reads it from ~/.localstack/default.env.

# LocalStack auth token with Snowflake access (never commit a real value).
LOCALSTACK_AUTH_TOKEN=

# Emulator image; defaults to the newest build. Pin a tag or digest to freeze it.
SNOWFLAKE_IMAGE=localstack/snowflake-next:latest

# Host port of the compose emulator (make up / seed / run). Testcontainers picks its own.
SNOWFLAKE_PORT=4566

# EMULATOR (default) or SNOWFLAKE_CLOUD (make test-cloud).
TEST_TARGET=EMULATOR

# Key pair used by make seed / make run (make up generates it).
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/rsa_key.p8

# Real Snowflake only: TEST_TARGET=SNOWFLAKE_CLOUD, or SPRING_PROFILES_ACTIVE=cloud for the app.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_HOST=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# App only (the test suite creates and drops its own CLAIMS_IT_<random> database).
SNOWFLAKE_DATABASE=CLAIMS
SNOWFLAKE_SCHEMA=CORE
SPRING_PROFILES_ACTIVE=

# Liquibase contexts; "default,scheduled" also resumes the KPI task (every 5 minutes).
CLAIMS_LIQUIBASE_CONTEXTS=default
