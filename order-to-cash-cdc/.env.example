# Every variable this sample reads, with its default. Export the ones you
# change in your shell: the Makefile passes them to docker compose and to the
# Python code (docker compose alone would also read a .env file here).

# LocalStack auth token for the emulator (falls back to ~/.localstack/default.env).
LOCALSTACK_AUTH_TOKEN=

# Emulator image (defaults to the newest) and host ports, all bound to 127.0.0.1.
SNOWFLAKE_IMAGE=localstack/snowflake-next:latest
SNOWFLAKE_PORT=4566
KAFKA_PORT=19092
CONNECT_PORT=18083

# EMULATOR (default) or SNOWFLAKE_CLOUD.
TEST_TARGET=EMULATOR

# Connection. Emulator defaults shown; on SNOWFLAKE_CLOUD, SNOWFLAKE_ACCOUNT and
# SNOWFLAKE_ROLE are required and SNOWFLAKE_HOST defaults to
# <account>.snowflakecomputing.com.
SNOWFLAKE_ACCOUNT=snowflake
SNOWFLAKE_HOST=
SNOWFLAKE_USER=SAMPLE_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/rsa_key.p8
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=O2C_WH

# Database created by init/ (used by make seed and the registered sink), and
# the role the Kafka connector uses.
O2C_DATABASE=O2C
O2C_CONNECTOR_ROLE=O2C_INGEST
