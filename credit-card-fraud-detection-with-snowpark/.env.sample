# Snowflake connection parameters.
#
# Copy to `.env.localstack` and `.env.snowflake` for usage with the demos.
#
# Leave env file as-is to connect to the LocalStack Snowflake emulator. To
# connect to your Snowflake account, fill in its settings and leave HOST and
# PORT empty.

ACCOUNTNAME=test
USERNAME=test
PASSWORD=test
DBNAME=test
SCHEMANAME=PUBLIC
WAREHOUSENAME=
ROLENAME=
HOST=snowflake.localhost.localstack.cloud
PORT=4566
