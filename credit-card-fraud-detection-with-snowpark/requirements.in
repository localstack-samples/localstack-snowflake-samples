# Production dependencies. The training script pins the UDF packages to the
# versions installed here, so the model trained locally loads in Snowflake.
scikit-learn
pandas
joblib
cachetools
numpy
matplotlib
pyarrow
snowflake-snowpark-python[pandas]
snowflake-connector-python[secure-local-storage,pandas]
python-dotenv

# Test dependencies
pytest

# Development dependencies
ipdb
black
sqlfluff
