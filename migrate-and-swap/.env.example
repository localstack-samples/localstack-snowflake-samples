# Every variable this sample reads, with its default. Copy to .env and
# uncomment what you want to change; the Makefile reads .env.

# LocalStack auth token. Default: from the environment, else ~/.localstack/default.env.
# Never commit it.
# LOCALSTACK_AUTH_TOKEN=

# Emulator image and host port.
# SNOWFLAKE_IMAGE=localstack/snowflake-next:latest
# SNOWFLAKE_PORT=4566

# EMULATOR or SNOWFLAKE_CLOUD.
# TEST_TARGET=EMULATOR

# Database and live schema for make seed / demo / release / rollback / status.
# make seed DROPS and recreates the database. The green schema is always
# <INVENTORY_SCHEMA>_GREEN. Tests create their own MAS_TEST_<random> databases
# and drop them; KEEP_TEST_DB=1 keeps them for debugging.
# INVENTORY_DATABASE=RETAIL
# INVENTORY_SCHEMA=INVENTORY
# KEEP_TEST_DB=

# pytest-xdist workers for make test.
# PYTEST_WORKERS=4

# Key pair used by every connection (generated by make up).
# SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/rsa_key.p8

# TEST_TARGET=SNOWFLAKE_CLOUD only. Use a non-production account: the suite
# creates the account-level role INVENTORY_READER and MAS_TEST_<random>
# databases that it drops afterwards.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_ROLE=ACCOUNTADMIN
# SNOWFLAKE_WAREHOUSE=
