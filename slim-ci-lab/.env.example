# Every variable Slim CI Lab reads, with its default. Nothing here is required
# for the emulator path except the LocalStack token. The Makefile does not load
# this file: export what you change (or `set -a; . ./.env; set +a`).

# --- Emulator --------------------------------------------------------------
# LocalStack auth token. The Makefile also reads ~/.localstack/default.env.
# LOCALSTACK_AUTH_TOKEN=
SNOWFLAKE_IMAGE=localstack/snowflake-next:latest
SNOWFLAKE_PORT=4566

# --- Shared ----------------------------------------------------------------
# EMULATOR (default) or SNOWFLAKE_CLOUD: picks the connection used by the
# loader, the demo and the tests.
TEST_TARGET=EMULATOR
# Key pair used for SNOWFLAKE_JWT auth. `make up` generates a throwaway one.
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/rsa_key.p8
# Database for raw data and dbt models. The test suite creates and drops its own.
DBT_DATABASE=SLIM_CI
# Pull request number for the `pr` target: models build into schema pr_<number>.
DBT_PR_NUMBER=local

# --- Real Snowflake (TEST_TARGET=SNOWFLAKE_CLOUD and the dbt `cloud` target) --
# Read only on the cloud path; the emulator path ignores them.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORMING
